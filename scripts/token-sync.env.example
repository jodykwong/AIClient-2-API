# Token Sync Configuration
# Copy this file to token-sync.env and customize as needed
# Usage: source token-sync.env && ./sync-tokens.sh sync

# Git repository path (default: current directory)
# TOKEN_SYNC_REPO=/path/to/AIClient-2-API

# Git branch name (default: main)
# TOKEN_SYNC_BRANCH=main

# Git remote name (default: origin)
# TOKEN_SYNC_REMOTE=origin

# Paths to sync (space-separated, default: configs/kiro configs/gemini)
# TOKEN_SYNC_PATHS="configs/kiro configs/gemini configs/qwen configs/antigravity"

# Log file path (default: logs/token-sync.log)
# TOKEN_SYNC_LOG=logs/token-sync.log

# Example configurations:

# Configuration 1: Sync all OAuth providers
# TOKEN_SYNC_PATHS="configs/kiro configs/gemini configs/qwen configs/antigravity"

# Configuration 2: Use dedicated tokens branch
# TOKEN_SYNC_BRANCH=tokens

# Configuration 3: Use different remote
# TOKEN_SYNC_REMOTE=backup

# Configuration 4: Custom log location
# TOKEN_SYNC_LOG=/var/log/aiclient2api/token-sync.log
